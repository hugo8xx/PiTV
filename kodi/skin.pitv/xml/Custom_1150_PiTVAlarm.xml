<?xml version="1.0" encoding="UTF-8"?>
<!-- PiTV wake-up screen. Opened by /usr/local/bin/pitv-alarm with ActivateWindow(1150).
     Text comes from home-window properties the script sets:
       pitv_alarm_title, pitv_alarm_count, pitv_alarm_msg -->
<window id="1150">
	<defaultcontrol>9150</defaultcontrol>
	<backgroundcolor>FF0B0B0A</backgroundcolor>
	<onunload>SetProperty(pitv_alarm_closed,1,home)</onunload>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0B0B0A">colors/white.png</texture>
		</control>
		<control type="label">
			<left>0</left><top>180</top><width>1920</width><height>90</height>
			<font>font52_title</font><align>center</align>
			<textcolor>FFD85A30</textcolor>
			<label>$INFO[Window(Home).Property(pitv_alarm_title)]</label>
		</control>
		<control type="label">
			<left>0</left><top>330</top><width>1920</width><height>380</height>
			<font>font_clock</font><align>center</align><aligny>center</aligny>
			<textcolor>FFECEAE3</textcolor>
			<label>$INFO[Window(Home).Property(pitv_alarm_count)]</label>
		</control>
		<control type="label">
			<left>0</left><top>760</top><width>1920</width><height>80</height>
			<font>font45_title</font><align>center</align>
			<textcolor>FFB4B2A9</textcolor>
			<label>$INFO[Window(Home).Property(pitv_alarm_msg)]</label>
		</control>
		<control type="label">
			<left>0</left><top>960</top><width>1920</width><height>50</height>
			<font>font27</font><align>center</align>
			<textcolor>FF5F5E5A</textcolor>
			<label>กด OK หรือ Back เพื่อปิด</label>
		</control>
		<!-- invisible focus target so OK/Back on the remote closes the screen -->
		<control type="button" id="9150">
			<left>-10</left><top>-10</top><width>1</width><height>1</height>
			<texturenofocus />
			<texturefocus />
			<onclick>SetProperty(pitv_alarm_cancel,1,home)</onclick>
			<onclick>Dialog.Close(all,true)</onclick>
			<onclick>ReplaceWindow(home)</onclick>
		</control>
	</controls>
</window>
