kodi/skin.pitv/media/
kodi/skin.pitv/xml/Home.xml

# voice clips made with macOS voices: generated by alarm/make_sounds.sh
alarm/sounds/

# screenshots of your TV (show channel logos)
screenshots/

__pycache__/
*.pyc
.DS_Store
