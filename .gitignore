# your settings (Wi-Fi name, IPs)
pitv.env

# channel artwork belongs to the channels: fetched locally by kodi/fetch_channels.py
kodi/channels/*.src
kodi/plugin.video.pitv/resources/media/
kodi/plugin.video.pitv/resources/channels.json

