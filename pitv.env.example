# PiTV settings. Copy to pitv.env (git-ignored) and edit:
#   cp pitv.env.example pitv.env
# Every script in this repo reads pitv.env if it exists.

# How the Mac reaches the Pi over SSH (key login, set up by boot/prepare-sd.sh)
PITV_HOST=pi@pitv.local
PITV_HOSTNAME=pitv

# Static IP for the Pi (Pi-hole needs one). Pick a free address on your LAN.
PITV_IP=192.168.1.50
PITV_GW=192.168.1.1

# Wi-Fi (Pi 3 = 2.4 GHz only). The password is never stored here:
# boot/prepare-sd.sh asks you to type it into the SD card yourself.
PITV_WIFI_SSID=YourWiFi_2.4G
PITV_WIFI_COUNTRY=TH
PITV_TIMEZONE=Asia/Bangkok

# Wake-up alarm (alarm/install.sh): main news channel, and a channel whose live
# stream is used when the main one is not live. @handle or UC... id.
PITV_ALARM_CHANNEL=@MorningNewsTV3
PITV_ALARM_BACKUP=@Krobkruakao3

# Voices made on the Mac with `say` (alarm clips and the pitv_say MCP tool)
PITV_VOICE_TH="Kanya (Enhanced)"
PITV_VOICE_EN=Samantha
